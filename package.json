{
  "name": "hkgpipi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:create": "tsx scripts/admin.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:services": "docker compose --profile scanning up -d postgres mailpit clamav",
    "check:scanner": "tsx scripts/check-scanner.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1170.0",
    "@aws-sdk/client-cost-explorer": "3.1170.0",
    "@aws-sdk/client-ec2": "3.1170.0",
    "@aws-sdk/client-rds": "3.1170.0",
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/client-sts": "3.1170.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "better-auth": "1.7.25",
    "dotenv": "18.0.10",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
