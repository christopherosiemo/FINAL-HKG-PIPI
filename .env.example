# Copy to .env. This example cannot accept a live payment.
DATABASE_URL=postgresql://hkgpipi:hkgpipi@127.0.0.1:55432/hkgpipi
DATABASE_SSL=false
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Local test payments must be explicitly enabled. Never use in production.
PAYMENTS_PROVIDER=stripe
ENABLE_TEST_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
# Owner-approved commercial documents and tax configuration.
LEGAL_APPROVED=false
LEGAL_TERMS_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
TAX_APPROVED=false
TAX_MODE=unconfigured
TAX_LABEL=
# Local capture is a real SMTP server; production requires authenticated TLS SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HKGpipi <enquiries@hkgpipi.com>
# Use workload identity in production; never ask customers for access keys.
AWS_REGION=eu-west-2
AWS_INTEGRATION_ENABLED=false
AWS_DISCOVERY_PRINCIPAL_ARN=
AWS_DISCOVERY_REGIONS=eu-west-2
# Local private files outside public/. S3 is recommended for multiple web replicas.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=.local/private-files
S3_BUCKET=
S3_REGION=eu-west-2
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KMS_KEY_ID=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Optional HTTPS error-monitoring webhook. Receives redacted route/digest metadata only.
ERROR_MONITORING_WEBHOOK_URL=
CONTACT_EMAIL=enquiries@hkgpipi.com

# none for direct local use. ALB reads only the final appended source address.
TRUSTED_PROXY=none
